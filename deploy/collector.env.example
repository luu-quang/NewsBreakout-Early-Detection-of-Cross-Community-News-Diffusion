# Copy to /etc/newsbreakout/collector.env and chmod 600. Never commit the real file.
HEALTHCHECKS_PING_URL=https://hc-ping.com/REPLACE-WITH-YOUR-UUID

# Optional: a SECOND, separate healthchecks.io check (create it yourself on
# the dashboard) for feed staleness only (see src/collect_v2/runner.py -
# a feed going quiet for FEED_STALE_HOURS_OVERRIDE hours is expected during
# normal quiet hours, so it never fails the main check above). Leave unset
# to skip this entirely - most deployments don't need a separate alert for it.
# HEALTHCHECKS_STALE_PING_URL=https://hc-ping.com/REPLACE-WITH-A-SECOND-UUID
